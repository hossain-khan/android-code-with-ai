<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Hardware Requirements for On-Device Large Language Model Inference
        
        Context & Guidelines:
        1. Vulkan 1.1+ (0x401000) & Vulkan Compute: Modern on-device AI runtimes (LiteRT-LM) require
           high-throughput GPU compute capabilities for token generation and prefill acceleration.
        2. Google Play Filtering: Directs Google Play to filter out older budget hardware lacking
           Vulkan compute extensions.
        
        Official Documentation & Sources:
        - Android Vulkan Guide: https://developer.android.com/ndk/guides/graphics/getting-started
        - Google Play Feature Filters: https://developer.android.com/google/play/filters
    -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:required="true" />

    <application
        android:name=".CodeWithAIApp"
        android:appComponentFactory=".di.ComposeAppComponentFactory"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        tools:targetApi="37"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:appComponentFactory">

        <!--
            Native Library Access for On-Device GPU Inference (LiteRT / TensorFlow Lite GPU Delegates)
            
            Context & Guidelines:
            1. Android Linker Namespace Isolation: On Android 8.0+ (API 26+), apps cannot dynamically load
               vendor libraries (/vendor/lib64/) via dlopen() unless declared via <uses-native-library>.
            2. Hardware Acceleration: Declaring 'libOpenCL.so' and 'libvndksupport.so' allows LiteRT's GPU
               delegate to access vendor OpenCL drivers on supported chipsets (Qualcomm Snapdragon Adreno,
               MediaTek / Samsung Exynos Mali).
            3. Graceful Fallback: Setting android:required="false" is mandatory so that devices without
               OpenCL drivers (e.g., Google Pixel Tensor devices utilizing Vulkan/WebGPU, or Emulators)
               can still install and run the app without package installation rejection.
            
            Official Documentation & Sources:
            - Android Native Libraries Manifest Guide:
              https://developer.android.com/guide/topics/manifest/uses-native-library-element
            - TensorFlow Lite / LiteRT GPU Delegate Specification (OpenCL on Android):
              https://www.tensorflow.org/lite/performance/gpu#android
            - Google AI Edge LiteRT Documentation:
              https://ai.google.dev/edge/litert
            - Google AI Edge LiteRT-LM Repository:
              https://github.com/google-ai-edge/LiteRT-LM
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            This is required to use this app's custom WorkManager configuration.
            https://developer.android.com/develop/background-work/background-tasks/persistent/configuration/custom-configuration
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Remove to use Application workManagerConfiguration -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Required for WorkManager foreground services on Android 14+.
            Without tools:node="merge" and foregroundServiceType="dataSync",
            download workers will crash on Android 14+.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />
    </application>

</manifest>