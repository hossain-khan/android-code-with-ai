<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Network Connectivity Permissions
        
        Context & Guidelines:
        - INTERNET: Required to download on-device LLM model weights from Hugging Face / Cloudflare CDN.
        - ACCESS_NETWORK_STATE: Allows WorkManager and OkHttp to detect active network connectivity (e.g. unmetered Wi-Fi).
        
        Official Documentation:
        - https://developer.android.com/training/basics/network-ops/connecting
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Foreground Service & Notification Permissions (Android 14+ / API 34+ Data Sync Policy)
        
        Context & Guidelines:
        1. Model Weights Transfer (2.6GB–3.7GB): On-device LLM weights require multi-minute downloads.
           A Foreground Service prevents Android's background execution limits (Doze mode, process killer)
           from killing downloads prematurely.
        2. FOREGROUND_SERVICE_DATA_SYNC: Mandated on Android 14+ (API 34+) when running WorkManager jobs
           with foregroundServiceType="dataSync".
        3. POST_NOTIFICATIONS: Android 13+ (API 33+) runtime permission to display the ongoing download progress bar
           and cancel action notification in the system notification shade.
        4. WAKE_LOCK: Prevents CPU from going to sleep while streaming model weights chunks to disk.
        
        Official Documentation & Play Console Policy:
        - Android 14 Foreground Service Types: https://developer.android.com/about/versions/14/changes/fgs-types-special-use#data-sync
        - Android Notification Runtime Permission: https://developer.android.com/develop/ui/views/notifications/notification-permission
        - WorkManager Foreground Services: https://developer.android.com/develop/background-work/background-tasks/persistent/how-to/long-running
        - Play Console Policy Justification Guide: project-resources/google-play/foreground-service-declaration.md
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Hardware Requirements for On-Device Large Language Model Inference
        
        Context & Guidelines:
        1. Vulkan 1.1+ (0x401000) & Vulkan Compute: Modern on-device AI runtimes (LiteRT-LM) require
           high-throughput GPU compute capabilities for token generation and prefill acceleration.
        2. Google Play Filtering: Directs Google Play to filter out older budget hardware lacking
           Vulkan compute extensions.
        
        Official Documentation & Sources:
        - Android Vulkan Guide: https://developer.android.com/ndk/guides/graphics/getting-started
        - Google Play Feature Filters: https://developer.android.com/google/play/filters
    -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:required="true" />

    <application
        android:name=".CodeWithAIApp"
        android:appComponentFactory=".di.ComposeAppComponentFactory"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        tools:targetApi="37"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:appComponentFactory">

        <!--
            Native Library Access for On-Device GPU Inference (LiteRT / TensorFlow Lite GPU Delegates)
            
            Context & Guidelines:
            1. Android Linker Namespace Isolation: On Android 8.0+ (API 26+), apps cannot dynamically load
               vendor libraries (/vendor/lib64/) via dlopen() unless declared via <uses-native-library>.
            2. Hardware Acceleration: Declaring 'libOpenCL.so' and 'libvndksupport.so' allows LiteRT's GPU
               delegate to access vendor OpenCL drivers on supported chipsets (Qualcomm Snapdragon Adreno,
               MediaTek / Samsung Exynos Mali).
            3. Graceful Fallback: Setting android:required="false" is mandatory so that devices without
               OpenCL drivers (e.g., Google Pixel Tensor devices utilizing Vulkan/WebGPU, or Emulators)
               can still install and run the app without package installation rejection.
            
            Official Documentation & Sources:
            - Android Native Libraries Manifest Guide:
              https://developer.android.com/guide/topics/manifest/uses-native-library-element
            - TensorFlow Lite / LiteRT GPU Delegate Specification (OpenCL on Android):
              https://www.tensorflow.org/lite/performance/gpu#android
            - Google AI Edge LiteRT Documentation:
              https://ai.google.dev/edge/litert
            - Google AI Edge LiteRT-LM Repository:
              https://github.com/google-ai-edge/LiteRT-LM
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.App"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link intent filter for in-app navigation (e.g. from model download notifications) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="models"
                    android:scheme="codematex" />
            </intent-filter>
        </activity>

        <!--
            This is required to use this app's custom WorkManager configuration.
            https://developer.android.com/develop/background-work/background-tasks/persistent/configuration/custom-configuration
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Remove to use Application workManagerConfiguration -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Required for WorkManager foreground services on Android 14+.
            Without tools:node="merge" and foregroundServiceType="dataSync",
            download workers will crash on Android 14+.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:node="merge" />
    </application>

</manifest>