<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
        Exclude multi-gigabyte on-device LLM model binaries (2.6GB–3.7GB)
        from Google Drive Auto Backup to prevent exceeding quotas and consuming bandwidth.
    -->
    <exclude domain="external" path="models" />
    <exclude domain="file" path="models" />
</full-backup-content>