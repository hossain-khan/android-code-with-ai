<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            Exclude multi-gigabyte on-device LLM model binaries (2.6GB–3.7GB)
            from Google Drive cloud backup.
        -->
        <exclude domain="external" path="models" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <!--
            Exclude multi-gigabyte models from device-to-device transfers to avoid
            prolonged transfer times; models will be re-downloaded on-demand.
        -->
        <exclude domain="external" path="models" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>